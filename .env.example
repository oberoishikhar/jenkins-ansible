# =============================================================================
# Environment Variables — Jenkins + Ansible Deployment Hub
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Edit .env with your values
#   3. Run: ./setup.sh
#
# ⚠️  NEVER commit your .env file to git — it contains passwords!
#     The .gitignore already excludes it.
# =============================================================================

# ─── Admin Credentials ───────────────────────────────────────────────────────
# CHANGE THESE before deploying!
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=changeme123

# ─── Network Ports ───────────────────────────────────────────────────────────
# Port for the Jenkins web interface
JENKINS_PORT=8080

# Port for Jenkins build agents (leave as-is unless you have a conflict)
AGENT_PORT=50000

# ─── Jenkins URL ─────────────────────────────────────────────────────────────
# If you access Jenkins via a hostname or reverse proxy, set this
# Examples:
#   http://localhost:8080/
#   http://jenkins.mycompany.internal:8080/
JENKINS_URL=http://localhost:8080/

# ─── Memory Settings ─────────────────────────────────────────────────────────
# Jenkins JVM heap size in MB
# Minimum: 512  Recommended: 768  For many projects: 1024+
JENKINS_MEM=768
